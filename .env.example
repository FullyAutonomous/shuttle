# Shuttle — local environment template.
#
# Copy to .env and fill in locally:   cp .env.example .env
#
# .env is ignored by .gitignore AND refused by the pre-commit/pre-push hooks in
# .githooks/. It must never be committed. This file may be committed — it is the
# only member of the .env.* family that is allowed.
#
# Leave a value empty until you actually have one. An empty value makes the
# half-configured state obvious; a plausible placeholder does not.

# --- Local services ---------------------------------------------------------
DATABASE_URL=
SHUTTLE_API_KEY=

# --- Agent / provider credentials -------------------------------------------
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
