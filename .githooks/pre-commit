#!/usr/bin/env bash
# pre-commit — structural git rules, then the never-commit guard.
#
#   scripts/git/pre-commit-rules.sh   branch rules, large files, conflict markers
#   scripts/guard/sensitive-guard.sh  agent state, .env, keys, secret content
#
# Both run on every commit. Rules live in scripts/git/lib.sh and
# scripts/guard/sensitive-guard.sh; documentation in scripts/git/README.md.
set -uo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

rules="$root/scripts/git/pre-commit-rules.sh"
[ -x "$rules" ] && { "$rules" || exit 1; }

guard="$root/scripts/guard/sensitive-guard.sh"
[ -x "$guard" ] && exec "$guard" staged

exit 0
